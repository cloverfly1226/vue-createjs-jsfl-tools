{
  "scripts": {
    "jsfl:build:lib": "tsc -p tsconfig.lib.json",
    "jsfl:build:main": "tsc -p tsconfig.main.json",
    "jsfl:build": "pnpm run jsfl:build:lib && pnpm run jsfl:build:main && node rename.mjs",
    "jsfl:watch:lib": "tsc-watch -p tsconfig.lib.json --onSuccess \"node rename.mjs\"",
    "jsfl:watch:main": "tsc-watch -p tsconfig.main.json --onSuccess \"node rename.mjs\""
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jsfl": "^0.0.41",
    "tsc-watch": "^7.2.1",
    "typescript": "4.9.5"
  }
}
